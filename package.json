{
	"name": "Kitsune Komix",
	"workspaces": [
		"./packages/*",
		"./services/*"
	],
	"module": "index.ts",
	"type": "module",
	"private": true,
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@types/bun": "latest"
	},
	"peerDependencies": {
		"typescript": "^5"
	},
	"scripts": {
		"dev": "bun --watch launcher.ts",
		"start": "bun launcher.ts",
		"api": "bun services/api/main.ts",
		"watcher": "bun services/watcher/index.ts",
		"worker": "bun services/worker/index.ts",
		"db:push": "bun --cwd packages/database run push",
		"db:migrate": "bun --cwd packages/database run migrate",
		"db:generate": "bun --cwd packages/database run generate",
		"format:project": "bunx --bun @biomejs/biome format --write"
	}
}
